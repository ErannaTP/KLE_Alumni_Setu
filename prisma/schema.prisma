generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ALUMNI
  STUDENT
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  passwordHash          String
  name                  String
  profilePic            String?
  bio                   String?
  achievements          String?
  skills                String?
  domains               String[] @default([])
  batchYear             Int?
  company               String?
  position              String?
  rating                Float?
  emailVerified         Boolean  @default(false)
  role                  UserRole @default(ALUMNI)
  passwordResetRequired Boolean  @default(true)
  otp                   String?
  otpExpiry             DateTime?

  student Student?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts    Post[]
  likes    Like[]
  comments Comment[]

  messagesSent Message[] @relation("SentMessages")
  messagesRecv Message[] @relation("ReceivedMessages")

  followers Follow[] @relation("Followers")
  following Follow[] @relation("Following")

  conversationsA Conversation[] @relation("UserAConversations")
  conversationsB Conversation[] @relation("UserBConversations")

  sentFriendRequests     FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")

  connections   Connection[] @relation("ConnectionUser")
  connectionsOf Connection[] @relation("ConnectionFriend")

  eventRegistrations EventRegistration[]
}

model Student {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  branch    String?
  batchYear Int?
  bio       String?
  domains   String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id])
  following User @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Post {
  id            String   @id @default(uuid())
  userId        String
  title         String?
  content       String
  imageUrls     String[] @default([])
  domain        String?
  hashtags      String[] @default([])
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  likes    Like[]
  comments Comment[]
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  text      String
  parentId  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senderId    String
  receiverId  String
  content     String
  replyToId   String?
  deliveredAt DateTime?
  seenAt      DateTime?
  edited      Boolean   @default(false)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAId String
  userBId String

  userA User @relation("UserAConversations", fields: [userAId], references: [id])
  userB User @relation("UserBConversations", fields: [userBId], references: [id])

  isRequestA Boolean @default(false)
  isRequestB Boolean @default(false)

  messages Message[]

  @@unique([userAId, userBId])
}

model FriendRequest {
  id String @id @default(uuid())

  senderId   String
  senderType UserRole
  senderUser User     @relation("FriendRequestSender", fields: [senderId], references: [id])

  receiverId   String
  receiverType UserRole
  receiverUser User     @relation("FriendRequestReceiver", fields: [receiverId], references: [id])

  status    FriendRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())
}

model Connection {
  id String @id @default(uuid())

  userId   String
  userType UserRole
  user     User     @relation("ConnectionUser", fields: [userId], references: [id])

  friendId   String
  friendType UserRole
  friend     User     @relation("ConnectionFriend", fields: [friendId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, userType, friendId, friendType])
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  otp       String?
  otpExpiry DateTime?
}

model Event {
  id              String   @id @default(uuid())
  title           String
  description     String?
  date            DateTime
  location        String
  type            String   @default("other")
  maxAttendees    Int?
  isVirtual       Boolean  @default(false)
  tags            String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  registrations EventRegistration[]
}

model EventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  attended  Boolean  @default(false)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}
